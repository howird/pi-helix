+    /// Replace the entire input buffer as one undoable edit, placing the caret
+    /// at the end under the current mode's cursor policy. Does not output itself.
+    pub fn replace_buffer(&mut self, buffer: String) {
+        self.editor.sync_edit_mode(self.edit_mode.edit_mode());
+        self.editor.line_buffer_mut().clear_selection();
+        self.editor.set_buffer(buffer, UndoBehavior::CreateUndoPoint);
+        if self.input_mode == InputMode::HistoryTraversal {
+            self.input_mode = InputMode::Regular;
+        }
+    }
+
+    /// Clear undo and redo history without changing the current edit state.
